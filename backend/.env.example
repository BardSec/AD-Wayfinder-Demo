# ─── Active Directory Connection ─────────────────────────────────────────────
AD_HOST=your-domain-controller.acme.local
AD_PORT=389
AD_USER=ACME\svc_adwayfinder
AD_PASSWORD=your_service_account_password
AD_BASE_DN=DC=acme,DC=local

# Optional: Enable SSL/TLS (recommended for production)
AD_USE_SSL=false
AD_USE_TLS=false

# ─── Demo Mode ───────────────────────────────────────────────────────────────
# Set to true to use built-in sample data without needing a real AD connection
USE_MOCK_DATA=true

# ─── Alert Thresholds ────────────────────────────────────────────────────────
# Number of days without login before an enabled account is flagged as stale
STALE_ACCOUNT_DAYS=180

# ─── Flask ───────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_PORT=5000

# ─── Microsoft Entra ID (Azure AD) Authentication ────────────────────────────
# Set AUTH_ENABLED=true once all values below are configured.
# Generate FLASK_SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_ENABLED=false
FLASK_SECRET_KEY=change-me-generate-with-secrets-token-hex-32

AZURE_TENANT_ID=531b9531-47be-461b-92f2-5fa613078a82
AZURE_CLIENT_ID=882a7184-9bb4-45d4-b8b5-c786ced83292
AZURE_CLIENT_SECRET=your_app_client_secret_from_azure_portal

# Redirect URI — must match exactly what is registered in your Azure app registration
AZURE_REDIRECT_URI=https://wayfinder.mc-schools.app/auth/callback
AZURE_POST_LOGOUT_URI=https://wayfinder.mc-schools.app

# M365 / Security group object ID — only members can sign in (leave blank to allow all tenant users)
ALLOWED_GROUP_ID=0abadbfe-264e-44de-afdb-5939c4d27aa2
